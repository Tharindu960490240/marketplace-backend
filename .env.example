# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env. Rotate any secret that has been committed.

# ======================
# SERVER
# ======================
PORT=3200
HOST=0.0.0.0

# ======================
# DATABASE (PostgreSQL)
# ======================
DEFAULT_DB=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ======================
# JWT AUTH
# ======================
# Use a long random value, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ======================
# FRONTEND URLS (used for email links + CORS)
# ======================
FRONTEND_URL=https://marketplace.agrilinkservices.com
FRONTEND_URL_2=http://localhost:4200

# ======================
# EMAIL
# ======================
# Zoho SMTP (nodemailer) — the active email service
EMAIL_USER=
EMAIL_PASS=
# Brevo (only if you switch to the Brevo email service file)
BREVO_API_KEY=

# ======================
# FILES / ASSETS
# ======================
LOGO_URL=

# ======================
# APP CONFIG
# ======================
MAX_ADS_COUNT=5

# ======================
# AWS S3
# ======================
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
